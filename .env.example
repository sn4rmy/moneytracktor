SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Used by the db container and docker-compose.yml.
POSTGRES_DB=moneytracktor
POSTGRES_USER=moneytracktor
POSTGRES_PASSWORD=moneytracktor

# Used when Django runs on the host. Inside Docker these are set in docker-compose.yml.
DATABASE_URL=postgres://moneytracktor:moneytracktor@localhost:5432/moneytracktor
CELERY_BROKER_URL=redis://localhost:6379/0
